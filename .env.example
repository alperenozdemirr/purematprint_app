APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Europe/Istanbul

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
IYZICO_CALLBACK_URL="${APP_URL}/payment/iyzico/callback"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_CURRENCY=try
STRIPE_SUCCESS_URL="${APP_URL}/payment/stripe/success?session_id={CHECKOUT_SESSION_ID}"
STRIPE_CANCEL_URL="${APP_URL}/payment/stripe/cancel?session_id={CHECKOUT_SESSION_ID}"

CHECKOUT_DRAFT_TTL_MINUTES=120

SHIPINK_USERNAME=
SHIPINK_PASSWORD=
SHIPINK_BASE_URL=https://api.dev.shipink.io
SHIPINK_WAREHOUSE_ID=
SHIPINK_CARRIER_ACCOUNT_ID=
SHIPINK_CARRIER_ID=aras
SHIPINK_CARRIER_SERVICE_ID=aras_standart
SHIPINK_CARD_ID=
SHIPINK_SALES_CHANNEL_ID=api
SHIPINK_SALES_CHANNEL_NAME="${APP_NAME}"
SHIPINK_DEFAULT_WEIGHT=1
SHIPINK_DEFAULT_LENGTH=20
SHIPINK_DEFAULT_WIDTH=15
SHIPINK_DEFAULT_HEIGHT=10
